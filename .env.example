# The hosted storage adapter. Omit both variables while running the legacy
# filesystem-backed prototype.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://chopin:chopin@127.0.0.1:5432/chopin?sslmode=disable

# Hosted GitHub sign-in. Generate the key with `openssl rand -hex 32`.
AUTH_DRIVER=github
APP_ORIGIN=http://127.0.0.1:8787
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_ENCRYPTION_KEY=
