{
	"$schema": "https://opencode.ai/config.json",

	"mcp": {
		"playwright": {
			"type": "local",
			"command": [
				"bunx",
				"@playwright/mcp@0.0.78",
				"--browser",
				"chrome",
				"--isolated"
			],
			"enabled": true
		},
		"chopin": {
			"type": "remote",
			"url": "https://chopin.githubnext.com/mcp",
			"headers": {
				"Authorization": "Bearer {env:GH_TOKEN}"
			},
			"oauth": false,
			"timeout": 30000,
			"enabled": true
		}
	}
}
