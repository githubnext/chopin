+export const getVariable = (name) => {
+  if (isNode) return conditions.undefinedToNull(process.env[name.toUpperCase().replaceAll('-', '_')])
+  // A browser whose storage refuses reads (a damaged profile) holds no configuration; reading it
+  // unguarded here, as this module loads, would stop every module that imports it.
+  try {
+    return conditions.undefinedToNull(storage.varStorage.getItem(name))
+  } catch (e) {
+    return null
+  }
