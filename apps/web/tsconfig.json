{
	"extends": [
		"../../tsconfig.json"
	],
	"include": [
		"src",
		"vite.config.ts"
	],
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client", "bun"],
		"paths": {
			"@/*": ["./src/*"],
			"@assistant-ui/react": ["./src/chat/assistant-ui/markdown-primitive.tsx"],
			"@assistant-ui/react-markdown": ["./src/chat/assistant-ui/markdown-primitive.tsx"],
			"@assistant-ui/react-markdown/styles/dot.css": ["./src/chat/assistant-ui/markdown-dot.css"],
			"lucide-react": ["./src/chat/assistant-ui/lucide.tsx"]
		},

		"allowSyntheticDefaultImports": true,

		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
