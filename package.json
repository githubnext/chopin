{
	"name": "chopin",
	"private": true,
	"packageManager": "bun@1.4.2",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:exe": "bun scripts/dev.ts --exe",
		"db:up": "docker compose -f compose.yaml -f compose.local.yaml up -d --wait db",
		"db:down": "docker compose -f compose.yaml -f compose.local.yaml down",
		"docker:up": "docker compose -f compose.yaml -f compose.local.yaml up -d --build --wait app",
		"docker:down": "docker compose -f compose.yaml -f compose.local.yaml down",
		"test:postgres": "TEST_DATABASE_URL=postgresql://chopin:chopin@127.0.0.1:5432/chopin?sslmode=disable bun test apps/server/src/storage/postgres",
		"migrate": "bun apps/server/src/storage/migrate.ts",
		"build": "bun run --filter '@chopin/web' build",
		"start": "bun run --filter '@chopin/server' start",
		"start:visual-preview": "bun apps/server/src/visual-preview/server.ts",
		"ci": "dprint check && oxlint && bun scripts/check-tokens.ts && bun scripts/check-design-contract.ts && bun scripts/check-design-record.ts && bun run design:check",
		"design:check": "node scripts/check-design.mjs",
		"fix": "dprint fmt && oxlint --fix",
		"types": "bun --filter '*' types && tsgo --noEmit --skipLibCheck -p e2e",
		"e2e": "bun scripts/e2e.ts",
		"e2e:ui": "bun scripts/e2e.ts --ui",
		"e2e:browsers": "bun node_modules/@playwright/test/cli.js install chromium",
		"design:test": "bun node_modules/@playwright/test/cli.js test --config e2e/design/playwright.config.ts",
		"design:behavior": "bun node_modules/@playwright/test/cli.js test --config e2e/design/behavior.config.ts",
		"design:browser": "bun scripts/design-browser.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@babel/parser": "7.29.7",
		"@playwright/test": "1.62.1",
		"@types/bun": "catalog:bun",
		"@typescript/native-preview": "7.0.0-dev.20260304.1",
		"dprint": "0.50.2",
		"impeccable": "4.1.0",
		"oxlint": "1.51.0",
		"parse5": "8.0.0",
		"postcss": "8.5.23",
		"postcss-value-parser": "4.2.0",
		"yaml": "2.9.0"
	},
	"patchedDependencies": {
		"@mdxeditor/editor@4.1.0": "patches/@mdxeditor%2Feditor@4.1.0.patch",
		"@ai-sdk/harness-pi@1.0.128": "patches/@ai-sdk%2Fharness-pi@1.0.128.patch",
		"mdast-util-to-markdown@2.1.2": "patches/mdast-util-to-markdown@2.1.2.patch"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalogs": {
			"bun": {
				"@types/bun": "1.4.2"
			},
			"copilot": {
				"@github/copilot": "1.0.80",
				"@github/copilot-sdk": "1.0.11"
			},
			"diffs": {
				"@pierre/diffs": "1.3.0"
			},
			"harness": {
				"@ai-sdk/harness": "1.0.126",
				"@ai-sdk/harness-pi": "1.0.128",
				"@ai-sdk/mcp": "2.0.60",
				"@ai-sdk/sandbox-just-bash": "1.0.126",
				"@bastani/atomic": "0.9.27",
				"@earendil-works/pi-coding-agent": "0.85.1",
				"ai": "7.0.116",
				"typebox": "1.3.7",
				"zod": "4.4.3"
			},
			"mdx": {
				"@lexical/headless": "0.48.0",
				"@lexical/link": "0.48.0",
				"@lexical/list": "0.48.0",
				"@lexical/react": "0.48.0",
				"@lexical/rich-text": "0.48.0",
				"@lexical/selection": "0.48.0",
				"@lexical/table": "0.48.0",
				"@lexical/utils": "0.48.0",
				"@lexical/yjs": "0.48.0",
				"@mdxeditor/editor": "4.1.0",
				"@mdxeditor/gurx": "1.2.4",
				"json-joy": "17.51.0",
				"katex": "0.16.22",
				"lexical": "0.48.0",
				"mermaid": "11.17.2",
				"y-protocols": "1.0.7",
				"yjs": "13.6.31"
			},
			"react": {
				"@types/react": "19.2.14",
				"@types/react-dom": "19.2.3",
				"@vitejs/plugin-react": "5.1.4",
				"react": "19.2.4",
				"react-dom": "19.2.4"
			},
			"ui": {
				"@tailwindcss/vite": "4.3.0",
				"tailwindcss": "4.3.0",
				"vite": "7.3.1",
				"vite-tsconfig-paths": "5.1.4"
			}
		}
	}
}
