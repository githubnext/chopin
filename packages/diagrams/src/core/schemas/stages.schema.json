{
	"title": "Stage pipelines: medallion, dp-integration",
	"required": [
		"stages"
	],
	"additionalProperties": false,
	"properties": {
		"dir": {
			"enum": [
				"LR",
				"TB"
			]
		},
		"stages": {
			"type": "array",
			"minItems": 2,
			"maxItems": 6,
			"items": {
				"type": "object",
				"required": [
					"label",
					"items"
				],
				"additionalProperties": false,
				"properties": {
					"label": {
						"type": "string",
						"maxLength": 28
					},
					"style": {
						"enum": [
							"solid",
							"dashed"
						]
					},
					"plain": {
						"type": "boolean"
					},
					"kind": {
						"enum": [
							"backend",
							"focal",
							"store",
							"external",
							"input",
							"optional",
							"security",
							"muted"
						]
					},
					"items": {
						"type": "array",
						"minItems": 1,
						"maxItems": 6,
						"items": {
							"anyOf": [
								{
									"type": "string",
									"maxLength": 40
								},
								{
									"type": "object",
									"required": [
										"label"
									],
									"additionalProperties": false,
									"properties": {
										"id": {
											"type": "string"
										},
										"label": {
											"type": "string",
											"maxLength": 40
										},
										"sub": {
											"type": "string",
											"maxLength": 48
										},
										"tag": {
											"type": "string",
											"maxLength": 8
										},
										"kind": {
											"type": "string"
										},
										"focal": {
											"type": "boolean"
										},
										"row": {
											"type": "integer"
										}
									}
								}
							]
						}
					}
				}
			}
		},
		"edges": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/edge"
			}
		}
	},
	"$defs": {
		"node": {
			"type": "object",
			"required": [
				"id"
			],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
				},
				"label": {
					"type": "string",
					"maxLength": 40
				},
				"sub": {
					"type": "string",
					"maxLength": 48
				},
				"tag": {
					"type": "string",
					"maxLength": 8
				},
				"kind": {
					"enum": [
						"backend",
						"focal",
						"store",
						"external",
						"input",
						"optional",
						"security",
						"muted"
					]
				},
				"focal": {
					"type": "boolean"
				},
				"shape": {
					"enum": [
						"box",
						"decision",
						"terminal",
						"io",
						"store",
						"state",
						"start",
						"end",
						"entity",
						"class"
					]
				},
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 40
				},
				"col": {
					"type": "integer",
					"minimum": 0,
					"maximum": 40
				},
				"group": {
					"type": "string"
				},
				"change": {
					"enum": [
						"added",
						"removed",
						"changed"
					]
				},
				"fields": {
					"type": "array",
					"maxItems": 16,
					"items": {
						"anyOf": [
							{
								"type": "string",
								"maxLength": 48
							},
							{
								"type": "array",
								"minItems": 1,
								"maxItems": 3,
								"items": {
									"type": "string"
								}
							}
						]
					}
				},
				"attrs": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"type": "string",
						"maxLength": 48
					}
				},
				"methods": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"type": "string",
						"maxLength": 48
					}
				},
				"status": {
					"enum": [
						"ok",
						"risk",
						"legacy",
						"retire"
					]
				},
				"lane": {
					"type": "string"
				}
			}
		},
		"edgeKind": {
			"enum": [
				"default",
				"primary",
				"link",
				"async",
				"return",
				"muted",
				"one-one",
				"one-many",
				"many-one",
				"many-many",
				"zero-many",
				"one-zero",
				"extends",
				"implements",
				"composes",
				"aggregates",
				"depends",
				"assoc",
				"line"
			]
		},
		"edge": {
			"anyOf": [
				{
					"type": "array",
					"minItems": 2,
					"maxItems": 4,
					"items": [
						{
							"type": "string"
						},
						{
							"type": "string"
						},
						{
							"type": "string"
						},
						{
							"$ref": "#/$defs/edgeKind"
						}
					]
				},
				{
					"type": "object",
					"required": [
						"from",
						"to"
					],
					"additionalProperties": false,
					"properties": {
						"id": {
							"type": "string"
						},
						"from": {
							"type": "string"
						},
						"to": {
							"type": "string"
						},
						"label": {
							"type": "string",
							"maxLength": 28
						},
						"kind": {
							"$ref": "#/$defs/edgeKind"
						},
						"both": {
							"type": "boolean"
						},
						"change": {
							"enum": [
								"added",
								"removed",
								"changed"
							]
						}
					}
				}
			]
		}
	}
}
