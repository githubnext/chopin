			"createdAt": "2021-11-21T00:26:26Z",
			"url": "https://github.com/home-assistant/architecture/discussions/668#discussioncomment-1676068",
			"summary": "A user suggests an opt-in option to ignore unavailable transitions, keeping the old default so nothing breaks.",
			"actorId": "MDQ6VXNlcjU4MjYxNjA=",
			"actorType": "human",
			"parentId": "D_kwDOByplq84AOGiF"
