			"url": "https://github.com/casey/just/discussions/2934#discussioncomment-14911559",
			"summary": "The same contributor asks whether the opener could instrument their own recipes instead, warning that even optional telemetry in just would be seen as a privacy intrusion by most users.",
			"actorId": "MDQ6VXNlcjE2NjI4NDEx",
			"actorType": "human",
			"parentId": "D_kwDOA6gfW84AirPE"
		},
