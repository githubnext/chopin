			"createdAt": "2025-10-30T19:40:17Z",
			"url": "https://github.com/casey/just/discussions/2934#discussioncomment-14830673",
			"summary": "The opener clarifies the data would go to the user's own team via a DSN set in an environment variable, not to the just maintainers.",
			"actorId": "MDQ6VXNlcjY0MjA5OTE=",
			"actorType": "human",
			"parentId": "DC_kwDOA6gfW84A4kvV"
		},
