			"url": "https://github.com/helix-editor/helix/pull/9143#issuecomment-1868313785",
			"summary": "The opener accepts bincode but disputes append-only, listing benefits of a single merged file such as per-type limits, chronological merging and clear trimming.",
			"actorId": 16072581,
			"actorType": "human",
			"parentId": "helix-9143:pr:9143"
		},
