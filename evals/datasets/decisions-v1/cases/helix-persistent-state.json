			"url": "https://github.com/helix-editor/helix/pull/9143#issuecomment-1868161124",
			"summary": "A maintainer explains serde lacks streaming serialization, prefers append-only session data with simple self-describing headers and bincode over msgpack.",
			"actorId": 61850714,
			"actorType": "human",
			"parentId": "helix-9143:pr:9143"
		},
