			"createdAt": "2020-12-20T11:51:54Z",
			"url": "https://github.com/excalidraw/excalidraw/discussions/2533#discussioncomment-227087",
			"summary": "A maintainer rejects stored metadata because it would go stale once the chart is edited by hand; users wanting another type can paste again.",
			"actorId": "MDQ6VXNlcjUxNTM4NDY=",
			"actorType": "human",
			"parentId": "MDE3OkRpc2N1c3Npb25Db21tZW50MjE3NzY5"
		},
