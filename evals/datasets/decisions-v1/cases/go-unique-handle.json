			"url": "https://github.com/golang/go/issues/62483#issuecomment-1708872411",
			"summary": "The same maintainer notes the design does not solve global per-type caches such as the json encoder cache, which leaks dynamically built types.",
			"actorId": 6354026,
			"actorType": "human",
			"parentId": "go-62483:issue:62483"
		},
